---
import { legalDocumentPath, type LegalDocument } from "../data/legal";

interface Props {
  document: LegalDocument;
}

const { document: doc } = Astro.props;
const href = legalDocumentPath(doc.slug);
---

<a
  href={href}
  class="legal-card group flex flex-col rounded-xl metal-border panel-app p-6 h-full transition duration-300 hover:border-brand-copper/50 copper-glow"
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <span
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-white/25 panel-app-strong text-white transition"
      aria-hidden="true"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
        <path
          fill-rule="evenodd"
          d="M4.5 3.75a3 3 0 0 0-3 3v10.5a3 3 0 0 0 3 3h15a3 3 0 0 0 3-3V6.75a3 3 0 0 0-3-3h-15Zm4.125 3a2.25 2.25 0 1 0 0 4.5 2.25 2.25 0 0 0 0-4.5Zm-3.873 8.703a4.126 4.126 0 0 1 7.746 0 .75.75 0 0 1-.351.92 7.47 7.47 0 0 1-3.522.796 7.47 7.47 0 0 1-3.522-.796.75.75 0 0 1-.351-.92Zm9.286-2.981a.75.75 0 0 0-1.061-1.06l-1.591 1.59-1.591-1.59a.75.75 0 0 0-1.06 1.061l2.121 2.12-2.121 2.122a.75.75 0 1 0 1.06 1.06l1.591-1.59 1.591 1.59a.75.75 0 0 0 1.06-1.061l-2.121-2.122 2.121-2.12Z"
          clip-rule="evenodd"></path>
      </svg>
    </span>
    <span class="text-[10px] uppercase tracking-wider text-white shrink-0">
      v{doc.version}
    </span>
  </div>
  <h2 class="font-display text-xl text-white transition-colors">
    {doc.title}
  </h2>
  <p class="mt-2 text-sm text-white flex-1">{doc.description}</p>
  <p class="mt-3 text-xs text-white">Last updated: {doc.lastUpdated}</p>
  <span
    class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-white transition"
  >
    View Document
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
      <path
        fill-rule="evenodd"
        d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
        clip-rule="evenodd"></path>
    </svg>
  </span>
</a>
