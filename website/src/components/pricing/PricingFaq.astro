---
import { PRICING_FAQ } from "../../data/pricingPage";
---

<section class="mx-auto max-w-3xl px-4 sm:px-6" aria-labelledby="pricing-faq-heading">
  <h2 id="pricing-faq-heading" class="font-display text-3xl text-white text-center mb-8">
    Frequently asked questions
  </h2>
  <div class="space-y-3" data-pricing-faq>
    {
      PRICING_FAQ.map((item, i) => (
        <details
          class="pricing-faq-item metal-border panel-app rounded-lg overflow-hidden group"
          data-faq-index={i}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-white font-medium hover:bg-white/10 transition">
            <span>{item.question}</span>
            <span
              class="text-white text-xl leading-none transition group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <div class="px-5 pb-4 text-sm text-white leading-relaxed border-t border-white/15">
            {item.answer}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .pricing-faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
