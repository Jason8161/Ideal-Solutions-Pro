---
import type { PricingTier } from "../../data/pricingPage";

interface Props {
  tier: PricingTier;
}

const { tier } = Astro.props;
---

<article
  class:list={[
    "pricing-tier-card metal-border panel-app group relative flex flex-col rounded-xl p-6 h-full",
    tier.mostPopular && "pricing-tier-card--popular ring-2 ring-brand-copper/60",
  ]}
  data-tier-id={tier.id}
  data-rc-product-id={tier.revenueCatProductId}
  data-rc-entitlement-id={tier.revenueCatEntitlementId}
>
  {tier.mostPopular && (
    <span
      class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full panel-app-strong border border-white/30 px-3 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white"
    >
      Most Popular
    </span>
  )}

  <h3 class="font-display text-2xl text-white">{tier.name}</h3>
  <p class="mt-2 text-3xl font-semibold text-white">{tier.priceLabel}</p>
  <p class="mt-2 text-sm text-white leading-relaxed">{tier.tagline}</p>

  <ul class="mt-6 space-y-2 text-sm text-white flex-1">
    {tier.features.map((f) => (
      <li class="flex gap-2">
        <span class="text-white shrink-0" aria-hidden="true">✓</span>
        <span>{f}</span>
      </li>
    ))}
  </ul>

  {
    tier.employeeNote && (
      <p class="mt-4 text-xs text-white border-t border-white/15 pt-4 leading-relaxed">
        {tier.employeeNote}
      </p>
    )
  }

  <a
    href={tier.ctaHref}
    class:list={["mt-6 block w-full text-center py-3", tier.mostPopular ? "btn-app" : "btn-app-outline"]}
    data-tier-id={tier.id}
    data-rc-product-id={tier.revenueCatProductId}
    data-rc-entitlement-id={tier.revenueCatEntitlementId}
  >
    {tier.ctaLabel}
  </a>
</article>
