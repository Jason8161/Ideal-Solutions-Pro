---
interface Props {
  content: string;
}

const { content } = Astro.props;
const blocks = content.split(/\n\n+/).map((b) => b.trim()).filter(Boolean);
---

<div class="legal-prose space-y-4 text-sm text-brand-muted leading-relaxed">
  {
    blocks.map((block) => {
      const lines = block.split("\n");
      const isList = lines.every((line) => line.startsWith("•") || line.trim() === "");
      if (isList && lines.some((l) => l.startsWith("•"))) {
        return (
          <ul class="list-none space-y-2 pl-1">
            {lines
              .filter((l) => l.startsWith("•"))
              .map((line) => (
                <li class="flex gap-2">
                  <span class="text-brand-legal shrink-0" aria-hidden="true">
                    •
                  </span>
                  <span>{line.replace(/^•\s*/, "")}</span>
                </li>
              ))}
          </ul>
        );
      }
      if (block.length < 80 && block === block.toUpperCase() && !block.includes(".")) {
        return <h2 class="font-display text-xl text-white pt-4 first:pt-0">{block}</h2>;
      }
      return <p>{block}</p>;
    })
  }
</div>
