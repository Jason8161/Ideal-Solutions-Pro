---
import { appStoreUrl, playStoreUrl } from "../data/site";

const ios = appStoreUrl();
const android = playStoreUrl();
const hasStoreLinks = Boolean(ios || android);
---

<div class="flex flex-wrap gap-3">
  {
    ios ? (
      <a
        href={ios}
        class="btn-app inline-flex"
        rel="noopener noreferrer"
        target="_blank"
      >
        Download on the App Store
      </a>
    ) : (
      <span
        class="btn-app-outline inline-flex cursor-not-allowed opacity-70"
        title="Coming soon"
      >
        App Store — Coming soon
      </span>
    )
  }
  {
    android ? (
      <a
        href={android}
        class="btn-app inline-flex"
        rel="noopener noreferrer"
        target="_blank"
      >
        Get it on Google Play
      </a>
    ) : (
      <span
        class="btn-app-outline inline-flex cursor-not-allowed opacity-70"
        title="Coming soon"
      >
        Google Play — Coming soon
      </span>
    )
  }
</div>
{
  !hasStoreLinks && (
    <p class="mt-2 text-xs text-white">
      Store links will appear here when the app is published.
    </p>
  )
}
