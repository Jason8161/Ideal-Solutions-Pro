---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 pb-16">
    <a href="/blog" class="text-sm text-brand-highlight hover:underline">← Blog</a>
    <time
      datetime={post.data.pubDate.toISOString()}
      class="mt-4 block text-xs text-brand-muted"
    >
      {post.data.pubDate.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </time>
    <h1 class="mt-2 font-display text-4xl text-white">{post.data.title}</h1>
    <p class="mt-3 text-brand-muted">{post.data.description}</p>
    <div class="mt-10 prose prose-invert prose-headings:font-display max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
