---
import BaseLayout from "../layouts/BaseLayout.astro";
import PricingTierCard from "../components/pricing/PricingTierCard.astro";
import PricingFaq from "../components/pricing/PricingFaq.astro";
import PricingFloatingCta from "../components/pricing/PricingFloatingCta.astro";
import PricingLocalStorage from "../components/pricing/PricingLocalStorage.astro";
import PricingAiAddons from "../components/pricing/PricingAiAddons.astro";
import {
  PRICING_HERO,
  FREE_TRIAL,
  PRICING_TIERS,
  COMPARISON_ROWS,
  PRICING_LEGAL_LINKS,
} from "../data/pricingPage";

const metaDescription =
  "Ideal Solutions Pro pricing — 7-day free trial (5 AI requests), Side Hustle $9.99, Boss Man $19.99, Super Boss Man $49.99, Enterprise $99.99. Local-first storage, AI add-ons, and crew plans.";
---

<BaseLayout title="Pricing" description={metaDescription}>
  <div class="pricing-page text-white">
  <section class="page-section-hero relative overflow-hidden">
    <div class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-white mb-3">
        Contractor SaaS · Local-first · No enterprise bloat
      </p>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl text-white leading-tight max-w-4xl mx-auto">
        {PRICING_HERO.title}
      </h1>
      <p class="mt-5 text-lg text-white max-w-2xl mx-auto leading-relaxed">
        {PRICING_HERO.subtitle}
      </p>
      <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href={FREE_TRIAL.ctaHref}
          class="btn-app w-full sm:w-auto px-8 py-3.5"
          data-cta="trial"
        >
          {FREE_TRIAL.ctaLabel}
        </a>
        <a href="#pricing-plans" class="btn-app-outline w-full sm:w-auto px-8 py-3.5">
          Compare Plans
        </a>
      </div>
    </div>
  </section>

  <section id="free-trial" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 scroll-mt-24">
    <div class="panel-app-strong metal-border copper-glow rounded-xl p-6 sm:p-8">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <h2 class="font-display text-2xl sm:text-3xl text-white">{FREE_TRIAL.title}</h2>
        <a href={FREE_TRIAL.ctaHref} class="btn-app shrink-0 text-center sm:px-6" data-cta="trial">
          {FREE_TRIAL.ctaLabel}
        </a>
      </div>
      <ul class="mt-6 grid gap-2 sm:grid-cols-2 text-sm text-white">
        {FREE_TRIAL.highlights.map((h) => (
          <li class="flex gap-2">
            <span class="text-white shrink-0" aria-hidden="true">✓</span>
            {h}
          </li>
        ))}
      </ul>
      <div class="mt-6 border-t border-white/15 pt-6">
        <p class="text-xs font-semibold uppercase tracking-wide text-white mb-2">
          Trial limits
        </p>
        <ul class="space-y-1.5 text-sm text-white">
          {FREE_TRIAL.limits.map((l) => (
            <li class="flex gap-2">
              <span aria-hidden="true">•</span>
              {l}
            </li>
          ))}
        </ul>
      </div>
      <p class="mt-6 text-xs text-white italic">{FREE_TRIAL.disclaimer}</p>
    </div>
  </section>

  <section id="pricing-plans" class="mx-auto max-w-6xl px-4 py-12 sm:px-6 scroll-mt-24">
    <h2 class="font-display text-3xl text-white text-center mb-2">Monthly plans</h2>
    <p class="text-center text-white text-sm mb-10 max-w-xl mx-auto">
      Subscribe in the app via Apple App Store or Google Play. RevenueCat-ready product IDs on each
      plan card.
    </p>
    <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {PRICING_TIERS.map((tier) => <PricingTierCard tier={tier} />)}
    </div>
  </section>

  <PricingLocalStorage />

  <PricingAiAddons />

  <section id="feature-comparison" class="mx-auto max-w-6xl px-4 py-16 sm:px-6 scroll-mt-24">
    <h2 class="font-display text-3xl text-white text-center mb-2">Feature comparison</h2>
    <p class="text-center text-white text-sm mb-8 max-w-lg mx-auto">
      Pick the tier that matches how you run jobs today — upgrade anytime as your crew grows.
    </p>
    <div class="overflow-x-auto rounded-xl metal-border panel-app">
      <table class="w-full min-w-[720px] text-sm text-left">
        <thead>
          <tr class="border-b border-white/15">
            <th class="px-4 py-3 text-white font-medium">Feature</th>
            <th class="px-4 py-3 text-white font-display">Side Hustle</th>
            <th class="px-4 py-3 text-white font-display">Boss Man</th>
            <th class="px-4 py-3 text-white font-display">Super Boss</th>
            <th class="px-4 py-3 text-white font-display">Enterprise</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/10">
          {COMPARISON_ROWS.map((row) => (
            <tr class="hover:bg-white/5 transition">
              <td class="px-4 py-3 text-white">{row.label}</td>
              <td class="px-4 py-3 text-white">{row.sideHustle}</td>
              <td class="px-4 py-3 text-white">{row.bossMan}</td>
              <td class="px-4 py-3 text-white">{row.superBossMan}</td>
              <td class="px-4 py-3 text-white">{row.enterprise}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="py-16 border-t border-brand-metal/30">
    <PricingFaq />
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6 pb-24 text-center border-t border-brand-metal/30">
    <h2 class="font-display text-xl text-white mb-4">Important notices</h2>
    <p class="text-xs text-white leading-relaxed mb-3">
      AI-generated responses may contain inaccuracies. Users are responsible for independently
      verifying estimates, calculations, code compliance, and business decisions.
    </p>
    <p class="text-xs text-white leading-relaxed mb-6">
      Employee GPS tracking requires proper employee consent and compliance with applicable laws.
    </p>
    <nav class="flex flex-wrap justify-center gap-4 text-sm" aria-label="Legal links">
      {PRICING_LEGAL_LINKS.map((link) => (
        <a href={link.href} class="text-white hover:underline transition">
          {link.label}
        </a>
      ))}
    </nav>
    <p class="mt-8 text-xs text-white">
      Prices shown in USD. Final billing through Apple App Store or Google Play may vary by region.
    </p>
  </section>

  <PricingFloatingCta />
  </div>
</BaseLayout>
