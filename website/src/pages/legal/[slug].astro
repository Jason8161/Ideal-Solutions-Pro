---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LegalDocumentBody from "../../components/LegalDocumentBody.astro";
import { LEGAL_DOCUMENTS, getLegalDocumentBySlug } from "../../data/legal";

export function getStaticPaths() {
  return LEGAL_DOCUMENTS.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { doc } = Astro.props;
---

<BaseLayout title={doc.title} description={doc.description}>
  <section class="gradient-hero-legal border-b border-brand-legal/20">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
      <a
        href="/legal"
        class="inline-flex items-center gap-1 text-sm text-brand-legal hover:text-brand-legal-light transition mb-6"
      >
        ← Back to Legal Stuff
      </a>
      <h1 class="font-display text-3xl sm:text-4xl text-white">{doc.title}</h1>
      <p class="mt-3 text-brand-muted">{doc.description}</p>
      <div class="mt-4 flex flex-wrap gap-4 text-xs text-brand-muted">
        <span>Version {doc.version}</span>
        <span>Last updated: {doc.lastUpdated}</span>
      </div>
    </div>
  </section>

  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6 pb-24">
    <LegalDocumentBody content={doc.content} />
    <div class="mt-12 flex flex-col sm:flex-row gap-3 pt-8 border-t border-brand-metal/30">
      <a
        href="/legal"
        class="inline-flex justify-center items-center gap-2 rounded-lg border border-brand-legal/40 bg-brand-legal/10 px-5 py-2.5 text-sm font-medium text-brand-legal-light hover:shadow-[0_0_20px_rgba(59,130,246,0.25)] transition"
      >
        ← Back to Legal Stuff
      </a>
      <a
        href="/"
        class="inline-flex justify-center items-center gap-2 rounded-lg metal-border bg-brand-surface px-5 py-2.5 text-sm font-medium text-white hover:border-brand-copper/50 transition"
      >
        Back to Home
      </a>
    </div>
  </article>
</BaseLayout>
