---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { BRAND_NAME, BRAND_TAGLINE } from "../data/site";
---

<BaseLayout
  title="About"
  description="Ideal Solutions Pro — contractor software from DIY side work to pro crews."
>
  <PageHero title="About Ideal Solutions" subtitle={BRAND_TAGLINE} />
  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 pb-16 prose prose-invert prose-headings:font-display prose-headings:tracking-wide">
    <p class="text-lg text-white leading-relaxed">
      {BRAND_NAME} is a mobile app for contractors who live on the jobsite — not behind a desk.
      We built it for electrical and construction trades: Job Folder for customers and jobs, AI when
      you need a quick answer, materials search across suppliers you already use, and Getting Paid
      through the apps your customers prefer.
    </p>
    <h2 class="font-display text-3xl text-white mt-12">Who it is for</h2>
    <ul class="mt-4 space-y-3 text-white">
      <li>
        <strong class="text-white">DIY & side work</strong> — calendars, basic estimating, and retail
        material search on Side Job mode.
      </li>
      <li>
        <strong class="text-white">Full-time contractors</strong> — employees, service calls, supply
        houses, and payment integrations on Bossman Mode.
      </li>
      <li>
        <strong class="text-white">Heavy users</strong> — blueprints, unlimited photo uploads, and
        advanced AI on Super Bossman.
      </li>
    </ul>
    <h2 class="font-display text-3xl text-white mt-12">Our approach</h2>
    <p class="text-white leading-relaxed">
      We match the industrial look and feel of the field: dark metal tones, condensed headlines, and
      tiles that map to real workflows. No bloated ERP — just the tools you reach for between
      conduit runs and panel upgrades.
    </p>
    <p class="mt-6">
      <a href="/contact" class="text-white font-medium hover:underline">
        Get in touch →
      </a>
    </p>
  </section>
</BaseLayout>
