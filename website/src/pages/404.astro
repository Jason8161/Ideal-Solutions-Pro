---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <PageHero title="404" subtitle="That page isn't on the jobsite map." />
  <section class="mx-auto max-w-xl px-4 py-12 sm:px-6 pb-16 text-center">
    <p class="text-brand-muted mb-8">
      Head back home or check features and pricing.
    </p>
    <a
      href="/"
      class="inline-block rounded-lg bg-brand-copper px-6 py-3 text-sm font-semibold text-brand-bg hover:brightness-110 transition"
    >
      Back to home
    </a>
  </section>
</BaseLayout>
