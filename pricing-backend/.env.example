# Copy to .env and adjust. Quick start: npm install && npm run dev
# Optional Postgres catalog cache: npm run setup:local (requires Docker)
# See also env.example (same template).

# Local Postgres (see docker-compose.yml): user postgres / password postgres / db pricing
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pricing
PORT=3001

# Optional: default base URL for employee invite deep links (e.g. custom scheme or web landing).
# WORKSPACE_APP_BASE_URL=https://your-host.example.com

# Expo app: EXPO_PUBLIC_PRICING_API_URL should be this API's root (http://YOUR_LAN_IP:3001), not …/api/pricing.

# Per-store catalog CSVs (one file per supplier recommended). See catalogs/README.md.
CATALOGS_DIR=./catalogs

# Optional legacy single-file import (also picked up by weekly refresh if the file exists).
PRICING_CSV_PATH=./sample-products.csv

CRON_SECRET=change-me-for-admin-refresh

# Set true on the long-running API process to import catalogs every Sunday at 3:00 AM (server local).
ENABLE_CRON=true

# Optional: live Lowe's search (third-party Unwrangle — NOT Lowe's official API).
# Get a key at https://console.unwrangle.com/ — paid plans apply.
# UNWRANGLE_API_KEY=

# Optional: live Home Depot search (Unwrangle homedepot_search — NOT Home Depot official).
# Get a key at https://console.unwrangle.com/ (same account as Lowe's Unwrangle key).
# HOMEDEPOT_API_KEY=          # defaults to UNWRANGLE_API_KEY when unset
# HOMEDEPOT_STORE_NO=8119     # store number for pickup/local inventory (see Unwrangle store list)
# HOMEDEPOT_ZIPCODE=84118     # required with store_no for store-local pricing/availability
# HOMEDEPOT_API_BASE_URL=https://data.unwrangle.com/api/getter/
#
# Sample API response (for mapper/filter tests, no key): samples/homedepot-search-response.json
# npm run verify:homedepot-sample
#
# Test: GET http://localhost:3001/search?q=14%2F2  (needs store_no + zipcode for best HD results)

# City Electric Supply — catalog CSV only (no Unwrangle live platform as of 2026).
# Drop price files in catalogs/cityelectric.csv, then npm run import:catalogs (or weekly cron).
# Live search returns supplier "City Electric"; orchestrator notes city_electric_live until a partner API exists.

# Lowe's official B2B Product Catalog is partner-only (portal.apim.lowes.com / SFTP invite).
# Home Depot, Graybar, Rexel, Grainger, etc. likewise require partner programs for official APIs.
# Weekly CSV catalogs in catalogs/ remain the source of truth when live APIs are unavailable.

# Customer Request Service (browser form at /r/{token}, POST /api/service-requests/submit).
# In my-app/.env set EXPO_PUBLIC_PRICING_API_URL to this server's public HTTPS root in production.

# Ideal Solutions AI Assistance (POST /api/ai-assistance) — key stays on the server only.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# AI_ASSISTANCE_TIMEOUT_MS=55000
# AI_ASSISTANCE_MAX_TOKENS=1024
