{
  "name": "ideal-solutions-pricing-api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "migrate": "npm run build && node dist/db/runMigrate.js",
    "seed:csv": "npm run build && node dist/scripts/importCsv.js",
    "import:catalogs": "npm run build && node dist/scripts/importCatalogs.js",
    "setup:local": "docker compose up -d postgres --wait && npm run migrate && npm run import:catalogs",
    "verify:homedepot-sample": "npm run build && node dist/scripts/verifyHomedepotSample.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
