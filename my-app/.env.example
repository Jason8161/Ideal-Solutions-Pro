# EAS builds on Windows without Git: npm scripts set EAS_NO_VCS=1 via cross-env.
# EAS CLI does not load EAS_NO_VCS from .env automatically; use npm run eas:* or set in the shell.
# EAS_NO_VCS=1

# EAS / Expo Push — UUID from `eas init` or expo.dev project settings (app.config.js also has a fallback).
EXPO_PUBLIC_EAS_PROJECT_ID=a6795a79-b97a-4580-855c-0d69dfb95b5b

# Pricing API — required for Materials search, AI Assistance, photo estimates, cloud sync, and more.
# Use your PC's LAN IP + pricing-backend port (default 3001). Physical devices cannot use localhost.
#
# Find LAN IP (PowerShell):  ipconfig   →  IPv4 Address (e.g. 192.168.1.33)
#
# AI Assistance: POST {base}/api/ai-assistance — OpenAI key stays on pricing-backend ONLY.
# 1) pricing-backend/.env: OPENAI_API_KEY=sk-…  (get key at https://platform.openai.com/api-keys)
# 2) pricing-backend: npm run dev
# 3) my-app/.env: EXPO_PUBLIC_PRICING_API_URL=http://YOUR_LAN_IP:3001
# 4) Restart Expo: npx expo start -c
#
# EAS / store builds: set EXPO_PUBLIC_PRICING_API_URL to your public HTTPS pricing-backend URL
# (EAS secret or eas.json env) and rebuild. Never put OPENAI_API_KEY in the mobile app.
EXPO_PUBLIC_PRICING_API_URL=

# Request Service customer link (browser form, no app install).
# When EXPO_PUBLIC_PRICING_API_URL is set, shared links use {base}/r/{yourDeviceToken}?companyName=...
# Optional dedicated form/API host (CDN or separate subdomain):
# EXPO_PUBLIC_SERVICE_REQUEST_BASE_URL=https://api.yourdomain.com
# Legacy alias: EXPO_PUBLIC_SERVICE_REQUEST_API_URL=https://api.yourdomain.com
# Optional static form host (must pass token + apiBase query params):
# EXPO_PUBLIC_CUSTOMER_REQUEST_URL=https://your-host/customer-request-invite.html

# Invoice PAY NOW hosted page for customers (browser, no app install).
# Defaults to EXPO_PUBLIC_PRICING_API_URL → pricing-backend serves /pay?invoice=…&amount=…&m=…
# Example: EXPO_PUBLIC_PAY_PAGE_BASE_URL=http://192.168.1.10:3001
# Production: EXPO_PUBLIC_PAY_PAGE_BASE_URL=https://api.yourdomain.com
EXPO_PUBLIC_PAY_PAGE_BASE_URL=

# Employee app store links (sent from Settings → Employees → Add/Edit employee → Invite).
# Crew uses the SAME app as the boss (com.idealsolutions.app) — employee mode is inside Ideal Solutions Pro.
# During TestFlight beta, set iOS to your public TestFlight link (App Store Connect → TestFlight → Public Link).
# EXPO_PUBLIC_EMPLOYEE_APP_IOS_URL=https://testflight.apple.com/join/XXXXXXXX
# EXPO_PUBLIC_EMPLOYEE_APP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.idealsolutions.app
# Optional aliases (used when employee-specific URLs are unset):
# EXPO_PUBLIC_PRO_IOS_STORE_URL=https://testflight.apple.com/join/XXXXXXXX
# EXPO_PUBLIC_IOS_TESTFLIGHT_URL=https://testflight.apple.com/join/XXXXXXXX

# Invite links (company users + crew cloud invites) — HTTPS web app or Expo web origin.
# Sent to pricing-backend as appBaseUrl; backend builds /invite/accept?code=… or /employee/join?code=…
# Local web dev: leave unset — app uses http://<metro-host>:8081 automatically.
# TestFlight / production: set to your hosted app URL (same origin as /employee/join).
# Example: EXPO_PUBLIC_APP_DEEP_LINK_BASE=https://app.yourdomain.com
# EXPO_PUBLIC_APP_DEEP_LINK_BASE=

# Developer-only features (Button images folder in Settings → Media folders).
# Must match Support email saved in Settings → User info (case-insensitive).
EXPO_PUBLIC_DEVELOPER_EMAIL=

# Optional: one-time unlock code if email match is not used. Enter in Settings → Developer after 7 taps on version.
# EXPO_PUBLIC_DEVELOPER_UNLOCK=

# Beta unlock (no store purchase) — internal preview / Expo Go QA only. Does NOT replace RevenueCat.
# Use when EXPO_PUBLIC_SUBSCRIPTIONS_DISABLED=true or preview EAS profile. For real subscribe flow, leave false.
# Metro: set true + `npx expo start -c`. Production store builds: always false (see SUBSCRIPTIONS_BEFORE_LAUNCH.md).
EXPO_PUBLIC_BETA_FULL_ACCESS=false

# Testing: disable paywalls and RevenueCat (Boss Man everywhere). false = normal plan picker + purchases.
# SUBSCRIPTIONS_DISABLED_FOR_TESTING in app.config.js must also be false before launch.
EXPO_PUBLIC_SUBSCRIPTIONS_DISABLED=false

# RevenueCat — Ideal Solutions Pro (Expo / react-native-purchases; NOT Swift Package Manager).
# EAS production/TestFlight: `.env` is NOT uploaded (.easignore). Create production env vars:
#   eas env:create --environment production --name EXPO_PUBLIC_RC_APPLE_KEY --value appl_xxx --visibility secret
#   eas env:create --environment production --name EXPO_PUBLIC_REVENUECAT_API_KEY --value appl_xxx --visibility secret
# WARNING: test_* keys are sandbox only. Use separate Apple/Google production keys before App Store release.
# Rebuild dev client / EAS after changing (native module + env baked at build time).
EXPO_PUBLIC_REVENUECAT_API_KEY=test_XJKjqvqShZHUzygpjjctnuWwdhV
# Optional platform-specific keys (override universal key when set):
# EXPO_PUBLIC_RC_APPLE_KEY=appl_xxxxxxxx
# EXPO_PUBLIC_RC_GOOGLE_KEY=goog_xxxxxxxx
# Entitlement identifier in RevenueCat dashboard (default: ideal_solutions_pro):
# EXPO_PUBLIC_RC_ENTITLEMENT=ideal_solutions_pro
#
# Debug TestFlight startup crash: skip RevenueCat configure on launch (rebuild EAS after changing).
# EXPO_PUBLIC_SKIP_RC_ON_LAUNCH=true
#
# Temporarily skip launch legal disclaimer modal (Settings → Legal Stuff still viewable). Re-enable: unset or false + EAS rebuild.
# EXPO_PUBLIC_SKIP_LEGAL_GATE=true
#
# Dashboard products to create (App Store Connect + Google Play + RevenueCat):
#   side_hustle_monthly        — $9.99/mo  → entitlement side_hustle
#   boss_man_monthly           — $19.99/mo → entitlement ideal_solutions_pro (Boss Man tier)
#   super_boss_man_monthly     — $49.99/mo → entitlement super_boss_man
#   enterprise_boss_man_monthly — $99.99/mo → entitlement enterprise_boss_man
