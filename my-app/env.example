# Ideal Solutions — construction contractors & DIY. Pricing API: your PC's LAN IP + pricing-backend port (default 3001). Use the server root only
# (e.g. http://192.168.1.10:3001), not …/api/pricing — the app appends /api/pricing/v1/… paths.
# Find LAN IP: ipconfig (Windows) or ifconfig (Mac). Do NOT use localhost on a physical phone.
# 1) pricing-backend: copy env.example to .env, npm run setup:local (needs Docker), npm run dev
# 2) Set URL below, restart Expo (npx expo start -c clears cache)
# Example: EXPO_PUBLIC_PRICING_API_URL=http://192.168.1.10:3001
#
# AI Assistance uses the same server root: POST {base}/api/ai-assistance (see docs/AI_ASSISTANCE.md).
# Set OPENAI_API_KEY in pricing-backend/.env — never put OpenAI keys in the mobile app.
# EAS/store builds: set EXPO_PUBLIC_PRICING_API_URL via eas secret:create before rebuilding.
#
# Dev convenience: http://localhost:3001 works for Expo web on the same PC. On native (__DEV__),
# localhost/127.0.0.1 is rewritten to the Metro host (expoConfig.hostUri) so phones reach your PC.
# If the URL is unset in __DEV__, the app infers http://<metro-host>:3001 (override port below if needed).
EXPO_PUBLIC_PRICING_API_URL=
# EXPO_PUBLIC_PRICING_API_PORT=3001
# EXPO_PUBLIC_PRICING_API_USE_HTTPS=true

# Expo Push: UUID from `eas init` or Project settings on expo.dev → copy into app config / here.
# Restart Expo after setting. Required for getExpoPushTokenAsync in development/production builds (not Expo Go on Android).
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Developer-only features (Button images folder in Settings). Restart Expo after changes (npx expo start -c).
# Match must equal Support email in Settings → User info (case-insensitive).
EXPO_PUBLIC_DEVELOPER_EMAIL=
# Optional one-time unlock code shown in Settings → Developer after 7 taps on version.
# EXPO_PUBLIC_DEVELOPER_UNLOCK=your-secret-phrase

# Optional: public base URL for customer “accept estimate” links in PDFs and emails.
# If unset, links use an Expo deep link (only works on a device with this app and local data).
# Example: EXPO_PUBLIC_ESTIMATE_ACCEPT_URL=https://your-site.com/estimate-accept
EXPO_PUBLIC_ESTIMATE_ACCEPT_URL=

# Invoice PAY NOW hosted page (pricing-backend /pay or your CDN). Defaults to EXPO_PUBLIC_PRICING_API_URL.
# Example: EXPO_PUBLIC_PAY_PAGE_BASE_URL=http://192.168.1.10:3001
EXPO_PUBLIC_PAY_PAGE_BASE_URL=

# Customer “request service call” — browser form (public/customer-request-invite.html).
# One HTTPS URL for the whole app build: every contractor who installs that build uses it; each invite link
# still carries that contractor’s email/phone/company in the query string (no separate HTML per account).
# Set once in EAS/CI for production, OR leave unset and put the same URL in SHIPPED_CUSTOMER_REQUEST_INVITE_PAGE
# in lib/customerServiceRequest.ts before you ship to the stores.
# Example: EXPO_PUBLIC_CUSTOMER_REQUEST_URL=https://yourcompany.github.io/ideal-invites/customer-request-invite.html
EXPO_PUBLIC_CUSTOMER_REQUEST_URL=

# Company user + crew invite links (HTTPS web app base). See also EXPO_PUBLIC_APP_DEEP_LINK_BASE in .env.example.
# Example: EXPO_PUBLIC_APP_DEEP_LINK_BASE=https://app.yourdomain.com
# EXPO_PUBLIC_APP_DEEP_LINK_BASE=

# RevenueCat (in-app subscriptions). Restart Expo / rebuild dev client after changes.
# Expo / React Native — use react-native-purchases (NOT Swift Package Manager).
# Create products in App Store Connect & Google Play, then link in RevenueCat:
#   side_hustle_monthly ($9.99/mo), boss_man_monthly ($19.99/mo),
#   super_boss_man_monthly ($49.99/mo), enterprise_boss_man_monthly ($99.99/mo)
# Entitlement: ideal_solutions_pro (display name: Ideal Solutions Pro)
EXPO_PUBLIC_REVENUECAT_API_KEY=test_XJKjqvqShZHUzygpjjctnuWwdhV
# EXPO_PUBLIC_RC_APPLE_KEY=appl_...
# EXPO_PUBLIC_RC_GOOGLE_KEY=goog_...
# EXPO_PUBLIC_RC_ENTITLEMENT=ideal_solutions_pro

# TestFlight / preview EAS profile / Expo Go — unlock all subscription features (Boss Man tier).
# Preview builds set this via eas.json; production store builds must leave it unset.
# EXPO_PUBLIC_BETA_FULL_ACCESS=true
