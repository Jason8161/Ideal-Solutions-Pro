{
  "name": "ideal-solutions",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "stop:metro": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-metro.ps1",
    "start:dev-client": "npx expo start --dev-client",
    "start:lan": "expo start -c --host lan",
    "start:phone": "npm run stop:metro && expo start -c --host lan",
    "start": "node ./scripts/echo-beta-env.js && expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "web": "expo start --web",
    "lint": "expo lint",
    "sync:home-images": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-home-images-from-folder.ps1",
    "sync:home-screen-buttons": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/sync-home-screen-buttons-from-folder.ps1",
    "catalog:home-screen-buttons": "node ./scripts/generate-home-screen-buttons-catalog.mjs",
    "slice:home-tile-presets": "node ./scripts/slice-home-tile-presets.mjs",
    "generate:home-tile-presets": "node ./scripts/generate-distinct-home-tile-presets.mjs",
    "generate:payment-brand-glyphs": "node ./scripts/generate-payment-app-brand-glyphs.mjs",
    "fetch:supplier-logos": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/fetch-supplier-logos.ps1",
    "setup:ai": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-ai-assistance.ps1",
    "eas:build:ios": "cross-env EAS_NO_VCS=1 eas build --profile production --platform ios",
    "eas:build:android": "cross-env EAS_NO_VCS=1 eas build --profile production --platform android",
    "eas:build:all": "npm run eas:prepare && cross-env EAS_NO_VCS=1 eas build --profile production --platform all",
    "eas:build:development:ios": "cross-env EAS_NO_VCS=1 eas build --profile development-device --platform ios",
    "eas:build:development:android": "cross-env EAS_NO_VCS=1 eas build --profile development --platform android",
    "eas:build:preview:ios": "cross-env EAS_NO_VCS=1 eas build --profile preview --platform ios",
    "eas:build:preview:android": "cross-env EAS_NO_VCS=1 eas build --profile preview --platform android",
    "eas:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-eas-upload.ps1",
    "eas:build:production:ios": "npm run eas:prepare && cross-env EAS_NO_VCS=1 eas build --profile production --platform ios",
    "eas:build:production:android": "npm run eas:prepare && cross-env EAS_NO_VCS=1 eas build --profile production --platform android",
    "eas:build:employee-ios": "cross-env EAS_NO_VCS=1 eas build --profile employee-ios --platform ios",
    "eas:build:employee-android": "cross-env EAS_NO_VCS=1 eas build --profile employee-android --platform android",
    "eas:submit:ios": "cross-env EAS_NO_VCS=1 eas submit --platform ios --profile production",
    "eas:submit:android": "cross-env EAS_NO_VCS=1 eas submit --platform android --profile production",
    "start:employee": "cross-env APP_VARIANT=employee EXPO_PUBLIC_APP_VARIANT=employee expo start",
    "check:invite-messages": "node ./scripts/check-invite-messages.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "dotenv": "~16.4.5",
    "expo": "~54.0.33",
    "expo-application": "~7.0.8",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech-recognition": "^56.0.0",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "installed-launcher-apps": "file:./modules/installed-launcher-apps",
    "jszip": "^3.10.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-purchases": "^10.1.2",
    "react-native-purchases-ui": "^10.1.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "cross-env": "^7.0.3",
    "eas-cli": "^16.17.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "sharp": "^0.34.2",
    "simple-icons": "^16.20.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
