# EAS archive ignores (required when EAS_NO_VCS=1; .gitignore is NOT used)
.expo
.expo/
.expo/**
**/.expo
**/.expo/**

# Local static export / review artifacts (never needed on EAS workers)
.expo-export-test
.expo-export-test/
.expo-export-test-build34
.expo-export-test-build34/
.expo-export-ipad-test
.expo-export-ipad-test/
.expo-export-ios-review
.expo-export-ios-review/
.expo-export-*/
.expo-export-*/**

dist-test-export/
dist-test-export/**

# Generated native projects (must be produced on EAS, not uploaded from Windows)
android
android/
ios
ios/

# Local env and secrets
.env
.env.*
!.env.example

# Dependencies and caches
node_modules/
node_modules/.cache/

# Build outputs
dist/
dist/**
web-build/

# Dev-only asset staging (sync scripts write here; app bundles assets/images/ instead)
assets/home-buttons/
assets/home-buttons/**
assets/images/_backup-home-tiles/
assets/images/_backup-home-tiles/**

# Logs and editor cruft
*.log
expo-lan.log
.DS_Store
Thumbs.db
